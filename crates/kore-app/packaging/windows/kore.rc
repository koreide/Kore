// Windows resources for kore.exe: the app icon (assets/icons/icon.ico) and
// version info.
// Compiled by build.rs via embed-resource, which defines KORE_ICON as the
// absolute path of assets/icons/icon.ico.
#include <winver.h>

1 ICON KORE_ICON

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "dev.kore"
      VALUE "FileDescription", "kore"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "kore"
      VALUE "OriginalFilename", "kore.exe"
      VALUE "ProductName", "kore"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

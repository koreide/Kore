# Used by 10-shell-boot-connection-error (merged in front of harness/.kube/config via KUBECONFIG).
# kore-broken: client certificate file is missing -> client creation fails at startup.
# kore-unreachable: nothing listens on 127.0.0.1:1 -> retry probe fails ("Cluster Unreachable").
apiVersion: v1
kind: Config
current-context: kore-broken
clusters:
- name: kore-broken
  cluster:
    server: https://127.0.0.1:1
    insecure-skip-tls-verify: true
- name: kore-unreachable
  cluster:
    server: https://127.0.0.1:1
    insecure-skip-tls-verify: true
users:
- name: kore-broken
  user:
    client-certificate: /nonexistent/kore-harness/client.crt
    client-key: /nonexistent/kore-harness/client.key
- name: kore-unreachable
  user:
    token: kore-harness-fake-token
contexts:
- name: kore-broken
  context: {cluster: kore-broken, user: kore-broken}
- name: kore-unreachable
  context: {cluster: kore-unreachable, user: kore-unreachable}
